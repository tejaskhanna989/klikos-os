# KlikOS kernel defconfig
# ARM64, QEMU virt target
# Clean-sheet mobile OS — not Android, not Linux

CONFIG_ARCH_AARCH64=y
CONFIG_MACH_VIRT=y
CONFIG_CPU_CORTEX_A72=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# Memory
CONFIG_MEMORY_SIZE_MB=1024
CONFIG_KERNEL_LOAD_ADDR=0x40080000
CONFIG_KERNEL_STACK_SIZE=32768

# Drivers
CONFIG_DRIVER_PL011_UART=y
CONFIG_PL011_BASE=0x09000000
CONFIG_PL011_BAUD=115200

# Planned (not yet implemented)
# CONFIG_FRAMEBUFFER=y
# CONFIG_INPUT_TOUCH=y
# CONFIG_STORAGE_EMMC=y
# CONFIG_RTC=y
# CONFIG_GICV2=y
# CONFIG_TIMER_ARM_SP804=y

# Userspace
CONFIG_INIT_PID=1
CONFIG_SHELL=y
CONFIG_DISPLAY_SERVER=y
CONFIG_WINDOW_MANAGER=y
CONFIG_FRAMEWORK=y
CONFIG_RUNTIME=y

# Debug
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_PRINTF=y
